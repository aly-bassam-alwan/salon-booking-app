  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "postgres": "^4.1.1",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "db:types": "supabase gen types typescript --schema public > src/types/database.ts",
    "db:test:race": "node scripts/db-race-test.mjs",
    "dev:users": "node scripts/dev-users.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      ".css$": "<rootDir>/jest/style-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
